{
  "name": "toma-zacatecas-app",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive 3D map of the 1914 Battle of Zacatecas (React + three.js)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phantasma-labs/batallazac.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
