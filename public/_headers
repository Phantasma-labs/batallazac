# Cloudflare static assets.
# The built JS and CSS have a hash in their name, so they never change under the same address.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# The films and sounds can be replaced under the same name, so they get an hour, not a year. Without a cache lifetime the edge does not
# keep them (the default is max-age=0, must-revalidate), and then it cannot answer Range requests with 206: a video could not seek.
/videos/*
  Cache-Control: public, max-age=3600
/audio/*
  Cache-Control: public, max-age=3600
/models/*
  Cache-Control: public, max-age=86400
/draco/*
  Cache-Control: public, max-age=86400
/extras/*
  Cache-Control: public, max-age=86400
