{
  // The built page is served from ./dist as static assets. A small Worker (worker/index.ts) runs first only for the films, which come
  // from the R2 bucket below so that they answer Range requests (seeking, Safari/iOS); everything else never reaches the Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toma-zacatecas",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/videos/*"]
  },
  "r2_buckets": [{ "binding": "FILMS", "bucket_name": "toma-zacatecas-films" }],
  // The public address; the old toma-zacatecas.phantomvfx.workers.dev keeps working too.
  "routes": [{ "pattern": "toma-zacatecas.phantasmalabs.com", "custom_domain": true }],
  "workers_dev": true
}
